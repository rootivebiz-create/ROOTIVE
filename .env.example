# Supabase（プロジェクト設定 → API から取得）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# サーバー専用（招待・招待リンクログイン・バックアップ保存のみで使用。ブラウザへは絶対に渡さない）
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# 公開 URL（招待リンク・メールのリンク生成に使用）
NEXT_PUBLIC_APP_URL=https://rootive-profit.vercel.app
# 任意：AI 月次分析を有効にする場合のみ
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# 本番のみ：Supabase の一時停止防止（/api/cron/keepalive）の認証キー。未設定だと定期アクセスは無効
# CRON_SECRET=（32 文字以上のランダムな文字列）
